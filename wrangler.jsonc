{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hubbub",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-22",
  "observability": {
    "enabled": true,
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOM",
        "class_name": "Room",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Room"],
    },
  ],
}
